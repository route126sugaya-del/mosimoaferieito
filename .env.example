# このリポジトリの役割は「商品検索 + もしもアフィリエイトリンク生成までを行い、
# 候補を data/product_queue.json に積む」ことのみ。記事の執筆・WordPress投稿は
# 行わない(2026-10-12方針変更。以前はClaude APIで記事本文も生成していたが、
# kamidera.comの既存ブログ運用(note-blog-autoリポジトリ)の文体・カテゴリ運用と
# 噛み合わない記事が直接投稿されてしまったため、記事化はnote-blog-auto側の
# 既存ワークフローに統合した)。

# ==== 楽天ウェブサービス ====
# https://webservice.rakuten.co.jp/ でアプリ登録(無料・審査不要)
# 2026年2月の認証刷新以降は applicationId と accessKey(pk_から始まる値)の
# 両方が必須。古いアプリのままだと400エラーになるため、新規にアプリ登録し直すこと。
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
# 新APIはリクエスト元検証のためRefererヘッダーを要求する。ここで指定したURLを
# 楽天アプリ管理画面の「許可されたWebサイト」に事前登録しておくこと
# (未登録・未設定だと HTTP 403 REQUEST_CONTEXT_BODY_HTTP_REFERRER_MISSING になる)。
RAKUTEN_REFERER=https://example.com/
# 楽天アフィリエイトID(任意。設定するとURLに affiliateId として付与されます)
RAKUTEN_AFFILIATE_ID=

# ==== Amazon Creators API ====
# 旧Product Advertising API (PA-API) は2026年5月に完全終了。
# Amazonアソシエイト管理画面(Associates Central)の「CreatorsAPI」タブから
# 新規にCredentialを発行すること(旧PA-APIのアクセスキーは使えない)。
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
AMAZON_PARTNER_TAG=
AMAZON_COUNTRY=JP

# ==== もしもアフィリエイト ====
# 管理画面 > プロモーション詳細 の広告リンクタグから a_id/p_id/pc_id/pl_id を取得してください。
# 楽天市場・Amazonそれぞれ提携ごとに異なる値が発行されます。
MOSHIMO_RAKUTEN_A_ID=
MOSHIMO_RAKUTEN_P_ID=
MOSHIMO_RAKUTEN_PC_ID=
MOSHIMO_RAKUTEN_PL_ID=

MOSHIMO_AMAZON_A_ID=
MOSHIMO_AMAZON_P_ID=
MOSHIMO_AMAZON_PC_ID=
MOSHIMO_AMAZON_PL_ID=

# ==== 実行設定 ====
# 1回の実行でキューに積む商品数
PRODUCTS_PER_RUN=1
