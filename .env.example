# ==== Claude (Anthropic) API ====
# 記事本文の生成に使用します。
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-5

# ==== 楽天ウェブサービス ====
# https://webservice.rakuten.co.jp/ でアプリ登録(無料・審査不要)
# 2026年2月の認証刷新以降は applicationId と accessKey(pk_から始まる値)の
# 両方が必須。古いアプリのままだと400エラーになるため、新規にアプリ登録し直すこと。
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
# 楽天アフィリエイトID(任意。設定するとURLに affiliateId として付与されます)
RAKUTEN_AFFILIATE_ID=

# ==== Amazon Creators API ====
# 旧Product Advertising API (PA-API) は2026年5月に完全終了。
# Amazonアソシエイト管理画面(Associates Central)の「CreatorsAPI」タブから
# 新規にCredentialを発行すること(旧PA-APIのアクセスキーは使えない)。
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
AMAZON_PARTNER_TAG=
AMAZON_COUNTRY=JP

# ==== もしもアフィリエイト ====
# 管理画面 > プロモーション詳細 の広告リンクタグから a_id/p_id/pc_id/pl_id を取得してください。
# 楽天市場・Amazonそれぞれ提携ごとに異なる値が発行されます。
MOSHIMO_RAKUTEN_A_ID=
MOSHIMO_RAKUTEN_P_ID=
MOSHIMO_RAKUTEN_PC_ID=
MOSHIMO_RAKUTEN_PL_ID=

MOSHIMO_AMAZON_A_ID=
MOSHIMO_AMAZON_P_ID=
MOSHIMO_AMAZON_PC_ID=
MOSHIMO_AMAZON_PL_ID=

# ==== WordPress ====
# 例: https://example.com (末尾スラッシュなし)
WP_BASE_URL=
WP_USERNAME=
# ユーザープロフィール画面で発行する「アプリケーションパスワード」(通常ログインパスワードではありません)
WP_APP_PASSWORD=
# draft(下書き) or publish(即時公開)。安全のため既定は draft を推奨します。
WP_POST_STATUS=draft

# ==== 実行設定 ====
# 1回の実行で生成する記事数
ARTICLES_PER_RUN=1
